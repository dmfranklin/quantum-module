    <exercise label="Final_31">
      <statement>
        <p>For these gates in parallel, which expression(s) could you use to determine the overall
          matrix for the circuit? Select all that apply.</p>
        <image source="Final_32.png" width="60%" />
      </statement>
      <choices>
        <choice>
          <statement>
            <p>a</p>
          </statement>
        </choice>
        <choice correct="yes">
          <statement>
            <p>b</p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>c</p>
          </statement>
        </choice>
        <choice correct="yes">
          <statement>
            <p>d</p>
