    <exercise label="Final_15">
      <statement>
        <p>Combine the following states into a single 4-qubit state:</p>
        <md>\ket{\psi_0} = \frac{1}{\sqrt{2}} \ket{00} - \frac{1}{\sqrt{2}} \ket{10}</md>
        <md>\ket{\psi_1} = \frac{\sqrt{2}}{\sqrt{5}} \ket{01} + \frac{\sqrt{2}}{\sqrt{5}} \ket{10} - \frac{1}{\sqrt{5}} \ket{11}</md>
        <xi:include href="math_latex_note.ptx" />
      </statement>
      <response />
    </exercise>
    <exercise label="Final_16">
      <statement>
        <p>Factor the following 3-qubit state into three separate 1-qubit states:</p>
        <md>\frac{1}{\sqrt{8}} \Big( \ket{000} - \ket{001} - \ket{010} + \ket{011} + \ket{100} - \ket{101} - \ket{110} + \ket{111} \Big)</md>
      </statement>
      <choices randomize="yes">
        <choice correct="yes">
          <statement>
            <p>
              <m>\Big( \frac{1}{\sqrt{2}} \big( \ket{0} + \ket{1} \big) \Big) \otimes \Big( \frac{1}{\sqrt{2}} \big( \ket{0} - \ket{1} \big) \Big) \otimes \Big( \frac{1}{\sqrt{2}} \big( \ket{0} - \ket{1} \big) \Big)</m>
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              <m>\Big( \frac{1}{\sqrt{2}} \big( \ket{0} - \ket{1} \big) \Big) \otimes \Big( \frac{1}{\sqrt{2}} \big( \ket{0} - \ket{1} \big) \Big) \otimes \Big( \frac{1}{\sqrt{2}} \big( \ket{0} + \ket{1} \big) \Big)</m>
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              <m>\Big( \frac{1}{\sqrt{2}} \big( \ket{0} - \ket{1} \big) \Big) \otimes \Big( \frac{1}{\sqrt{2}} \big( \ket{0} + \ket{1} \big) \Big) \otimes \Big( \frac{1}{\sqrt{2}} \big( \ket{0} - \ket{1} \big) \Big)</m>
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              <m>\frac{1}{\sqrt{2}} \ket{000} - \frac{1}{\sqrt{2}} \ket{111}</m>
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>
    <exercise label="Final_17">
      <statement>
        <p>For each of the following, select the transformation if it represents a <em>global phase
          change</em>.</p>
      </statement>
      <choices randomize="yes">
        <choice correct="yes">
          <statement>
            <p>
              <m>\ket{111} \rightarrow -\ket{111}</m>
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              <m>\frac{1}{\sqrt{2}} (\ket{00} + \ket{11}) \rightarrow \frac{1}{\sqrt{2}} (\ket{00} - \ket{11})</m>
            </p>
          </statement>
        </choice>
        <choice correct="yes">
          <statement>
            <p>
              <m>\frac{1}{2} (\ket{00} - \ket{01} - \ket{10} + \ket{11}) \rightarrow -\frac{1}{2} \ket{11} + \frac{1}{2} \ket{01} + \frac{1}{2} \ket{10} - \frac{1}{2} \ket{00}</m>
            </p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>
              <m>\begin{bmatrix}1\\0\\0\\0\\0\\0\\0\\1\end{bmatrix} \rightarrow \begin{bmatrix}1\\0\\0\\0\\0\\0\\-1\\0\end{bmatrix}</m>
            </p>
          </statement>
        </choice>
      </choices>
    </exercise>
    <exercise label="Final_18">
      <statement>
        <p>Consider the two-qubit state <m>\frac{1}{\sqrt{6}} \ket{11} + \frac{\sqrt{2}}{\sqrt{6}} \ket{10} + \frac{\sqrt{3}}{\sqrt{6}} \ket{00}</m>. Suppose we <em>measure the first qubit</em>, and we
          get a measurement result of 1. What is the probability of measuring a 0 in the second
          state?</p>
        <p>
          <em>Hint: first write down what the state transforms to after measuring the first (left)
            qubit as a 1. What do the new probability amplitudes become?</em>
        </p>
      </statement>
      <choices randomize="yes">
        <choice correct="yes">
          <statement>
            <p>66.666%</p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>100%</p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>0%</p>
          </statement>
        </choice>
        <choice>
          <statement>
            <p>33.333%</p>
          </statement>
        </choice>
      </choices>
    </exercise>
